{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pnr",
    "empId",
    "journeyType",
    "inventoryId",
    "state",
    "seatIds",
    "amountPaise",
    "refundable",
    "holdExpiresAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pnr": {
      "type": ["string", "null"]
    },
    "empId": {
      "type": "string"
    },
    "journeyType": {
      "type": "string",
      "enum": ["flight", "bus"]
    },
    "inventoryId": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": ["HELD", "CONFIRMED", "CANCELLED", "EXPIRED"]
    },
    "seatIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "amountPaise": {
      "type": "integer",
      "minimum": 0
    },
    "refundable": {
      "type": "boolean"
    },
    "holdExpiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}